# AssemblyAI: speech-to-text, LLM Gateway and text-to-speech all use this one key.
# Get it at https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# LiveKit: not needed for `console`, only for `dev` and `start`.
# Get them at https://cloud.livekit.io (project Settings > Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. The folder of notes the agent works in. Defaults to ./sample-workspace locally
# and to /workspace in the container.
# WORKSPACE_ROOT=

# Optional. A voice id from the dashboard's voice library, or a cloned voice's id, and the
# name the agent answers to. Defaults to Audrey.
# TTS_VOICE_ID=
# ASSISTANT_NAME=

# Optional. LLM Gateway model and thinking effort. Defaults: gemma-4-31b, low.
# The intended model is claude-sonnet-5-5; the free tier can't use third-party models yet.
# LLM_MODEL=
# LLM_REASONING_EFFORT=
